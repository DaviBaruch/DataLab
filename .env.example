# ============================================================
# DataLab — variáveis de ambiente (EXEMPLO)
# ------------------------------------------------------------
# Copie este arquivo para .env e preencha com seus valores.
# O arquivo .env real NUNCA deve ser versionado no Git
# (ele já está no .gitignore).
# ============================================================

# --- PostgreSQL (usado pelo serviço do Docker Compose) ---
POSTGRES_USER=datalab
POSTGRES_PASSWORD=senha
POSTGRES_DB=datalab
POSTGRES_PORT=5432

# --- Conexão da aplicação Python/ETL com o banco ---
# Padrão: postgresql://<usuario>:<senha>@<servico>:<porta>/<banco>
# O host 'postgres' é o nome do serviço no Docker Compose.
DATABASE_URL=postgresql://datalab:senha@postgres:5432/datalab
